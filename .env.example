# pokemonkarten.at – environment for web, worker and migrate.
# Copy to /opt/pokeshop/production.env (and staging.env) on the server.
# Never commit real values.

NODE_ENV=production
# Public URL of this stack (no trailing slash)
PUBLIC_BASE_URL=https://pokemonkarten.at
LOG_LEVEL=info

# --- Database: own database + user on the existing PostgreSQL server ---
# Extensions pg_trgm and unaccent must be allowed for this user (or created once by an admin).
DATABASE_URL=postgres://pokeshop:CHANGE_ME@db.example.internal:5432/pokeshop
# "require" when the server is reached over the network with TLS, "disable" on a private network
DATABASE_SSL=require

# --- Stripe (test keys on staging, live keys in production) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Optional: payment methods offered (card includes Apple Pay and Google Pay)
# STRIPE_PAYMENT_METHODS=card,eps,paypal

# --- Microsoft Graph: sending mail as bestellung@pokemonkarten.at ---
GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Certificate credential: path inside the container to a PEM file holding private key + certificate
GRAPH_CLIENT_CERT_PATH=/run/secrets/graph-cert.pem
GRAPH_SENDER=bestellung@pokemonkarten.at
# Instead of the certificate, a client secret works too (certificate preferred)
# GRAPH_CLIENT_SECRET=
# Local development only: write mails as files into this folder instead of sending them
# MAIL_DIR=./.mails

# --- Admin sign-in with Microsoft Entra ID ---
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=CHANGE_ME
# Members of these groups (or holders of the app roles Shop.Owner / Shop.Staff) may sign in
ENTRA_OWNER_GROUP_ID=
ENTRA_STAFF_GROUP_ID=
# Local development only: allows a sign-in without Microsoft. Works only while
# PUBLIC_BASE_URL points to localhost, so it can never open a real shop.
ADMIN_DEV_LOGIN=false

# --- Secret generated once per stack ---
# Encrypts the API keys' secrets. 32 random bytes, base64:  openssl rand -base64 32
API_KEY_MASTER_KEY=

# --- Files and master data ---
MEDIA_DIR=/data/media
TCGDEX_BASE_URL=https://api.tcgdex.net/v2

# --- License service for the scanner app (container "license") ---
# Own database + user on the same PostgreSQL server (not the shop's database)
LICENSE_DATABASE_URL=postgres://pokeshop_license:CHANGE_ME@db.example.internal:5432/pokeshop_license
# Encrypts the stored licence keys. 32 random bytes, base64:  openssl rand -base64 32
LICENSE_MASTER_KEY=
# The shop's token for /v1/shop/* (at least 32 characters):  openssl rand -base64 32
LICENSE_SHOP_TOKEN=
# Where the shop reaches the license service (inside the stack)
LICENSE_SERVICE_URL=http://license:3100
