{
  "name": "pokeshop",
  "private": true,
  "description": "Overpriced Cardboard \u2013 online shop for single Pok\u00e9mon TCG cards",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --filter @pokeshop/web dev",
    "build": "pnpm --filter @pokeshop/web build",
    "migrate": "node packages/core/scripts/migrate.ts",
    "test": "pnpm run test:core && pnpm run test:db && pnpm run test:integration",
    "test:core": "node --test \"packages/core/test/*.test.ts\"",
    "test:db": "bash scripts/db-test.sh",
    "test:integration": "node --test --test-concurrency=4 \"packages/core/test/integration/*.test.ts\" \"apps/worker/test/*.test.ts\" \"apps/license/test/*.test.ts\"",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p apps/worker --noEmit && tsc -p apps/license --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "prettier": "^3.8.1",
    "typescript": "^6.0.3"
  }
}
