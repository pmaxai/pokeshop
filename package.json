{
  "name": "pokeshop",
  "private": true,
  "description": "pokemonkarten.at – online shop for single Pokémon TCG cards",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "pnpm run test:core && pnpm run test:db",
    "test:core": "node --test \"packages/core/test/**/*.test.ts\"",
    "test:db": "bash scripts/db-test.sh",
    "typecheck": "tsc -p packages/core --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2"
  }
}
