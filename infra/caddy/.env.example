# Copy to infra/caddy/.env on the server.
ACME_EMAIL=order@overpricedcardboard.com
# Staging basic auth. Create the hash with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
# Keep the single quotes: the hash contains $ signs, which Compose would otherwise expand.
STAGING_USER=pokeshop
STAGING_PASSWORD_HASH='$2a$14$replace-with-your-hash'
